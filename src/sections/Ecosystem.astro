---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { pick, localePath, type Copy, type Locale } from "../i18n/index.ts";
import { links } from "../lib/links.ts";
import SectionHeader from "../components/SectionHeader.astro";
import Bird from "../components/Bird.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

type Tone = "text" | "accent" | "amber";
const tools: { name: string; href?: string; status?: string; tone: Tone; bird?: boolean }[] = [
  { name: "Perry", href: links.github, tone: "text", bird: true },
  { name: "Geisterhand", href: links.geisterhand, status: "geisterhand.io", tone: "text" },
  { name: "Perry Publish", href: localePath(lang, "publish"), status: "$ perry publish", tone: "accent" },
  { name: "Coop", tone: "amber" },
];

const copy: Copy<{
  title: string;
  aside: string;
  steps: string[];
  descriptions: string[];
  perryStatus: string;
  coopStatus: string;
}> = {
  en: {
    title: "Test, ship and host\nwith the same toolchain.",
    aside: "The compiler is the core. These tools handle testing, publishing and hosting.",
    steps: ["COMPILE", "TEST", "SHIP", "HOST"],
    descriptions: [
      "TypeScript to a native binary for 11 targets.",
      "UI testing that drives your app's real widgets.",
      "From main.ts to the App Store: build, sign, verify and submit.",
      "Runs Perry-compiled TypeScript apps over HTTP.",
    ],
    perryStatus: "MIT · open source",
    coopStatus: "Pre-1.0",
  },
  es: {
    title: "Prueba, publica y aloja\ncon las mismas herramientas.",
    aside: "El compilador es el núcleo. Estas herramientas se encargan de las pruebas, la publicación y el alojamiento.",
    steps: ["COMPILAR", "PROBAR", "PUBLICAR", "ALOJAR"],
    descriptions: [
      "De TypeScript a un binario nativo para 11 plataformas.",
      "Tests de UI que controlan los widgets reales de tu app.",
      "De main.ts a la App Store: compila, firma, verifica y envía.",
      "Ejecuta apps de TypeScript compiladas con Perry sobre HTTP.",
    ],
    perryStatus: "MIT · código abierto",
    coopStatus: "Pre-1.0",
  },
  de: {
    title: "Testen, ausliefern und hosten\nmit derselben Toolchain.",
    aside: "Der Compiler ist der Kern. Diese Tools übernehmen Testen, Veröffentlichen und Hosting.",
    steps: ["KOMPILIEREN", "TESTEN", "AUSLIEFERN", "HOSTEN"],
    descriptions: [
      "TypeScript zu einem nativen Binary für 11 Plattformen.",
      "UI-Tests, die die echten Widgets deiner App steuern.",
      "Von main.ts in den App Store: bauen, signieren, prüfen und einreichen.",
      "Führt mit Perry kompilierte TypeScript-Apps über HTTP aus.",
    ],
    perryStatus: "MIT · Open Source",
    coopStatus: "Vor 1.0",
  },
  fr: {
    title: "Testez, livrez et hébergez\navec la même toolchain.",
    aside: "Le compilateur est au cœur. Ces outils gèrent les tests, la publication et l'hébergement.",
    steps: ["COMPILER", "TESTER", "LIVRER", "HÉBERGER"],
    descriptions: [
      "De TypeScript à un binaire natif pour 11 plateformes.",
      "Des tests d'UI qui pilotent les vrais widgets de votre app.",
      "De main.ts à l'App Store : build, signature, vérification et soumission.",
      "Exécute sur HTTP des apps TypeScript compilées avec Perry.",
    ],
    perryStatus: "MIT · open source",
    coopStatus: "Pré-1.0",
  },
  it: {
    title: "Testa, distribuisci e ospita\ncon la stessa toolchain.",
    aside: "Il compilatore è il cuore. Questi strumenti si occupano di test, pubblicazione e hosting.",
    steps: ["COMPILA", "TESTA", "DISTRIBUISCI", "OSPITA"],
    descriptions: [
      "Da TypeScript a un binario nativo per 11 piattaforme.",
      "Test di UI che pilotano i veri widget della tua app.",
      "Da main.ts all'App Store: build, firma, verifica e invio.",
      "Esegue su HTTP app TypeScript compilate con Perry.",
    ],
    perryStatus: "MIT · open source",
    coopStatus: "Pre-1.0",
  },
  ja: {
    title: "テスト、配布、ホスティングまで\n同じツールチェーンで。",
    aside: "中心にあるのはコンパイラです。テスト、公開、ホスティングはこれらのツールが担います。",
    steps: ["コンパイル", "テスト", "配布", "ホスト"],
    descriptions: [
      "TypeScriptを11の対応先向けネイティブバイナリに。",
      "アプリの実際のウィジェットを操作するUIテスト。",
      "main.tsからApp Storeまで：ビルド、署名、検証、提出。",
      "PerryでコンパイルしたTypeScriptアプリをHTTPで実行。",
    ],
    perryStatus: "MIT · オープンソース",
    coopStatus: "1.0前",
  },
  ko: {
    title: "테스트, 배포, 호스팅까지\n같은 툴체인으로.",
    aside: "핵심은 컴파일러입니다. 테스트, 배포, 호스팅은 이 도구들이 맡습니다.",
    steps: ["컴파일", "테스트", "배포", "호스팅"],
    descriptions: [
      "TypeScript를 11개 타깃용 네이티브 바이너리로.",
      "앱의 실제 위젯을 조작하는 UI 테스트.",
      "main.ts에서 App Store까지: 빌드, 서명, 검증, 제출.",
      "Perry로 컴파일한 TypeScript 앱을 HTTP로 실행.",
    ],
    perryStatus: "MIT · 오픈 소스",
    coopStatus: "1.0 이전",
  },
  pt: {
    title: "Teste, publique e hospede\ncom as mesmas ferramentas.",
    aside: "O compilador é o núcleo. Estas ferramentas cuidam dos testes, da publicação e da hospedagem.",
    steps: ["COMPILAR", "TESTAR", "PUBLICAR", "HOSPEDAR"],
    descriptions: [
      "De TypeScript a um binário nativo para 11 plataformas.",
      "Testes de UI que controlam os widgets reais do seu app.",
      "Do main.ts à App Store: compile, assine, verifique e envie.",
      "Executa apps TypeScript compilados com Perry sobre HTTP.",
    ],
    perryStatus: "MIT · código aberto",
    coopStatus: "Pré-1.0",
  },
  th: {
    title: "ทดสอบ เผยแพร่ และโฮสต์\nด้วยทูลเชนเดียวกัน",
    aside: "คอมไพเลอร์คือหัวใจหลัก ส่วนเครื่องมือเหล่านี้ดูแลการทดสอบ การเผยแพร่ และการโฮสต์",
    steps: ["คอมไพล์", "ทดสอบ", "เผยแพร่", "โฮสต์"],
    descriptions: [
      "จาก TypeScript เป็นไบนารีเนทีฟสำหรับ 11 แพลตฟอร์ม",
      "ทดสอบ UI โดยควบคุมวิดเจ็ตจริงของแอปคุณ",
      "จาก main.ts สู่ App Store: บิลด์ เซ็น ตรวจสอบ และส่ง",
      "รันแอป TypeScript ที่คอมไพล์ด้วย Perry ผ่าน HTTP",
    ],
    perryStatus: "MIT · โอเพนซอร์ส",
    coopStatus: "ก่อน 1.0",
  },
  tr: {
    title: "Aynı araç zinciriyle test edin,\nyayınlayın ve barındırın.",
    aside: "Derleyici işin merkezinde. Test, yayınlama ve barındırmayı bu araçlar üstlenir.",
    steps: ["DERLE", "TEST ET", "YAYINLA", "BARINDIR"],
    descriptions: [
      "TypeScript'ten 11 platform için yerel ikili dosyaya.",
      "Uygulamanızın gerçek widget'larını kullanan UI testleri.",
      "main.ts'ten App Store'a: derleyin, imzalayın, doğrulayın ve gönderin.",
      "Perry ile derlenmiş TypeScript uygulamalarını HTTP üzerinden çalıştırır.",
    ],
    perryStatus: "MIT · açık kaynak",
    coopStatus: "1.0 öncesi",
  },
  vi: {
    title: "Kiểm thử, phát hành và lưu trữ\nvới cùng một bộ công cụ.",
    aside: "Trình biên dịch là cốt lõi. Các công cụ này lo phần kiểm thử, phát hành và lưu trữ.",
    steps: ["BIÊN DỊCH", "KIỂM THỬ", "PHÁT HÀNH", "LƯU TRỮ"],
    descriptions: [
      "Từ TypeScript thành binary gốc cho 11 nền tảng.",
      "Kiểm thử UI điều khiển các widget thật của ứng dụng.",
      "Từ main.ts đến App Store: build, ký, xác minh và gửi duyệt.",
      "Chạy ứng dụng TypeScript biên dịch bằng Perry qua HTTP.",
    ],
    perryStatus: "MIT · mã nguồn mở",
    coopStatus: "Trước 1.0",
  },
  id: {
    title: "Uji, rilis, dan hosting\ndengan toolchain yang sama.",
    aside: "Compiler adalah intinya. Alat-alat ini menangani pengujian, publikasi, dan hosting.",
    steps: ["KOMPILASI", "UJI", "RILIS", "HOSTING"],
    descriptions: [
      "Dari TypeScript ke binary native untuk 11 platform.",
      "Pengujian UI yang mengendalikan widget asli aplikasi Anda.",
      "Dari main.ts ke App Store: build, tanda tangani, verifikasi, dan kirim.",
      "Menjalankan aplikasi TypeScript hasil kompilasi Perry melalui HTTP.",
    ],
    perryStatus: "MIT · open source",
    coopStatus: "Pra-1.0",
  },
  "zh-Hans": {
    title: "测试、发布与托管，\n使用同一套工具链。",
    aside: "编译器是核心。这些工具负责测试、发布和托管。",
    steps: ["编译", "测试", "发布", "托管"],
    descriptions: [
      "将 TypeScript 编译为面向 11 个平台的原生二进制。",
      "驱动应用真实组件的 UI 测试。",
      "从 main.ts 到 App Store：构建、签名、验证并提交。",
      "通过 HTTP 运行用 Perry 编译的 TypeScript 应用。",
    ],
    perryStatus: "MIT · 开源",
    coopStatus: "1.0 之前",
  },
};
const t = pick(copy, lang);
const statuses = [t.perryStatus, tools[1].status, tools[2].status, t.coopStatus];
---

<section class="section section--surface eco">
  <div class="wrap">
    <SectionHeader title={t.title} aside={t.aside} />

    <ol class="chain">
      {tools.map((tool, i) => {
        const Tag = tool.href ? "a" : "div";
        return (
          <li data-reveal style={`--i: ${i}`}>
            <Tag class="card" href={tool.href}>
              <span class="card__top">
                <span class="step">
                  <span class="muted">{String(i + 1).padStart(2, "0")}</span> <span class="accent">{t.steps[i]}</span>
                </span>
                {tool.href && <ArrowRight class="card__arrow" size={16} stroke-width={1.75} aria-hidden="true" />}
              </span>
              <h3 class="card__name">
                {tool.bird && <Bird size={26} />}
                {tool.name}
              </h3>
              <p class="card__text muted">{t.descriptions[i]}</p>
              <p class:list={["card__status", tool.tone]}>{statuses[i]}</p>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .eco .wrap {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .chain {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--border);
  }
  .chain > li + li {
    border-left: 1px solid var(--border);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 32px 28px 36px;
  }
  .chain > li:first-child .card {
    padding-left: 0;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
  }
  .step {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
  }
  .card__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.8px;
  }
  .card__text {
    font-size: 15px;
    line-height: 23px;
  }
  .card__status {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .text {
    color: var(--text);
  }
  .amber {
    color: var(--pixel-amber);
  }
  a.card :global(.card__arrow) {
    transition: transform 200ms var(--ease-out);
  }
  a.card:hover .card__name {
    color: var(--accent);
  }
  a.card:hover :global(.card__arrow) {
    color: var(--text);
    transform: translateX(2px);
  }

  @media (max-width: 900px) {
    .chain {
      grid-template-columns: repeat(2, 1fr);
    }
    .chain > li:nth-child(odd) {
      border-left: 0;
    }
    .chain > li:nth-child(odd) .card {
      padding-left: 0;
    }
    .chain > li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 560px) {
    .chain {
      grid-template-columns: 1fr;
    }
    .chain > li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .card {
      padding: 24px 0;
      gap: 10px;
    }
  }
</style>
