---
import { pick, type Copy, type Locale } from "../i18n/index.ts";
import { formatInteger } from "../lib/format.ts";
import { getParity } from "../lib/perry-data.ts";
import { links } from "../lib/links.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Measured figures come from test-parity/node_suite_baseline.json in the Perry repo; 97% is the goal.
const measured = await getParity();
const parity = { passing: measured.pass, total: measured.total, modules: measured.modules, target: 97 };
const passing = formatInteger(parity.passing, lang);
const total = formatInteger(parity.total, lang);
const donePct = (parity.passing / parity.total) * 100;

const copy: Copy<{
  caption: string;
  body: string;
  progress: string;
  target: string;
  npmTitle: string;
  npmList: string;
  wall: string;
  perModule: string;
}> = {
  en: {
    caption: `is the target for Node 26 compatibility. ${passing} of ${total} tests pass today.`,
    body: `We run Node 26's test suite against Perry module by module and compare the output with Node. ${total} tests across ${parity.modules} modules. Failing tests are listed in the repository.`,
    progress: `${passing} / ${total} passing`,
    target: `target: ${parity.target}%`,
    npmTitle: "REAL NPM PACKAGES, COMPILED NATIVELY",
    npmList:
      "Fastify · Express · mysql2 · pg · ioredis · ws · bcrypt · jsonwebtoken and more. Plain JavaScript compiles too. Known gaps are listed in the repository.",
    wall: `${parity.modules} TRACKED node:* MODULES`,
    perModule: "Per-module pass rates →",
  },
  es: {
    caption: `es el objetivo de compatibilidad con Node 26. Hoy pasan ${passing} de ${total} pruebas.`,
    body: `Ejecutamos la suite de pruebas de Node 26 contra Perry, módulo a módulo, y comparamos la salida con la de Node. ${total} pruebas en ${parity.modules} módulos. Las pruebas que fallan están listadas en el repositorio.`,
    progress: `${passing} / ${total} superadas`,
    target: `objetivo: ${parity.target}%`,
    npmTitle: "PAQUETES NPM REALES, COMPILADOS A NATIVO",
    npmList:
      "Fastify · Express · mysql2 · pg · ioredis · ws · bcrypt · jsonwebtoken y más. El JavaScript puro también compila. Las limitaciones conocidas están listadas en el repositorio.",
    wall: `${parity.modules} MÓDULOS node:* MONITORIZADOS`,
    perModule: "Tasa de éxito por módulo →",
  },
  de: {
    caption: `ist das Ziel für die Kompatibilität mit Node 26. Heute bestehen ${passing} von ${total} Tests.`,
    body: `Wir führen die Testsuite von Node 26 Modul für Modul gegen Perry aus und vergleichen die Ausgabe mit Node. ${total} Tests in ${parity.modules} Modulen. Fehlschlagende Tests sind im Repository aufgeführt.`,
    progress: `${passing} / ${total} bestanden`,
    target: `Ziel: ${parity.target}%`,
    npmTitle: "ECHTE NPM-PAKETE, NATIV KOMPILIERT",
    npmList:
      "Fastify · Express · mysql2 · pg · ioredis · ws · bcrypt · jsonwebtoken und mehr. Reines JavaScript lässt sich ebenfalls kompilieren. Bekannte Lücken sind im Repository aufgeführt.",
    wall: `${parity.modules} ÜBERWACHTE node:*-MODULE`,
    perModule: "Erfolgsquote pro Modul →",
  },
  fr: {
    caption: `est l'objectif de compatibilité avec Node 26. Aujourd'hui, ${passing} tests sur ${total} passent.`,
    body: `Nous exécutons la suite de tests de Node 26 sur Perry, module par module, et comparons la sortie avec celle de Node. ${total} tests répartis sur ${parity.modules} modules. Les tests en échec sont listés dans le dépôt.`,
    progress: `${passing} / ${total} réussis`,
    target: `objectif : ${parity.target}%`,
    npmTitle: "DE VRAIS PAQUETS NPM, COMPILÉS EN NATIF",
    npmList:
      "Fastify · Express · mysql2 · pg · ioredis · ws · bcrypt · jsonwebtoken et d'autres. Le JavaScript pur se compile aussi. Les lacunes connues sont listées dans le dépôt.",
    wall: `${parity.modules} MODULES node:* SUIVIS`,
    perModule: "Taux de réussite par module →",
  },
  it: {
    caption: `è l'obiettivo di compatibilità con Node 26. Oggi passano ${passing} test su ${total}.`,
    body: `Eseguiamo la suite di test di Node 26 su Perry, modulo per modulo, e confrontiamo l'output con quello di Node. ${total} test in ${parity.modules} moduli. I test che falliscono sono elencati nel repository.`,
    progress: `${passing} / ${total} superati`,
    target: `obiettivo: ${parity.target}%`,
    npmTitle: "VERI PACCHETTI NPM, COMPILATI IN NATIVO",
    npmList:
      "Fastify · Express · mysql2 · pg · ioredis · ws · bcrypt · jsonwebtoken e altri. Anche il JavaScript puro si compila. Le lacune note sono elencate nel repository.",
    wall: `${parity.modules} MODULI node:* MONITORATI`,
    perModule: "Tasso di successo per modulo →",
  },
  ja: {
    caption: `がNode 26互換性の目標です。現在${total}件中${passing}件のテストが成功しています。`,
    body: `Node 26のテストスイートをモジュールごとにPerryで実行し、出力をNodeと比較しています。${parity.modules}モジュールで計${total}件のテスト。失敗しているテストはリポジトリに一覧があります。`,
    progress: `${passing} / ${total} 成功`,
    target: `目標: ${parity.target}%`,
    npmTitle: "実際のNPMパッケージをネイティブにコンパイル",
