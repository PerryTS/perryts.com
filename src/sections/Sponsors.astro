---
import Heart from "@lucide/astro/icons/heart";
import { pick, type Copy, type Locale } from "../i18n/index.ts";
import { links } from "../lib/links.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const copy: Copy<{ title: string; premium: string; sponsor: string; pitch: string; cta: string }> = {
  en: {
    title: "Sponsored by",
    premium: "Premium sponsor",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Sponsoring Perry funds work on the open-source compiler.",
    cta: "Become a sponsor",
  },
  es: {
    title: "Con el patrocinio de",
    premium: "Patrocinador premium",
    sponsor: "Patrocinador · nubjs.com",
    pitch: "Patrocinar Perry financia el trabajo en el compilador open source.",
    cta: "Hazte patrocinador",
  },
  de: {
    title: "Gesponsert von",
    premium: "Premium-Sponsor",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Wer Perry sponsert, finanziert die Arbeit am Open-Source-Compiler.",
    cta: "Sponsor werden",
  },
  fr: {
    title: "Avec le soutien de",
    premium: "Sponsor premium",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Sponsoriser Perry finance le travail sur le compilateur open source.",
    cta: "Devenir sponsor",
  },
  it: {
    title: "Sponsorizzato da",
    premium: "Sponsor premium",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Sponsorizzare Perry finanzia il lavoro sul compilatore open source.",
    cta: "Diventa sponsor",
  },
  ja: {
    title: "スポンサー",
    premium: "プレミアムスポンサー",
    sponsor: "スポンサー · nubjs.com",
    pitch: "Perryへのスポンサーは、オープンソースのコンパイラ開発の資金になります。",
    cta: "スポンサーになる",
  },
  ko: {
    title: "후원사",
    premium: "프리미엄 후원사",
    sponsor: "후원사 · nubjs.com",
    pitch: "Perry를 후원하면 오픈 소스 컴파일러 개발에 쓰입니다.",
    cta: "후원하기",
  },
  pt: {
    title: "Patrocinado por",
    premium: "Patrocinador premium",
    sponsor: "Patrocinador · nubjs.com",
    pitch: "Patrocinar o Perry financia o trabalho no compilador open source.",
    cta: "Seja um patrocinador",
  },
  th: {
    title: "ผู้สนับสนุน",
    premium: "ผู้สนับสนุนระดับพรีเมียม",
    sponsor: "ผู้สนับสนุน · nubjs.com",
    pitch: "การสนับสนุน Perry ช่วยให้มีทุนพัฒนาคอมไพเลอร์โอเพนซอร์ส",
    cta: "ร่วมเป็นผู้สนับสนุน",
  },
  tr: {
    title: "Sponsorlarımız",
    premium: "Premium sponsor",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Perry'ye sponsor olmak, açık kaynak derleyici üzerindeki çalışmaları finanse eder.",
    cta: "Sponsor olun",
  },
  vi: {
    title: "Được tài trợ bởi",
    premium: "Nhà tài trợ premium",
    sponsor: "Nhà tài trợ · nubjs.com",
    pitch: "Tài trợ Perry giúp duy trì công việc trên trình biên dịch mã nguồn mở.",
    cta: "Trở thành nhà tài trợ",
  },
  id: {
    title: "Disponsori oleh",
    premium: "Sponsor premium",
    sponsor: "Sponsor · nubjs.com",
    pitch: "Mensponsori Perry mendanai pengembangan compiler open source.",
    cta: "Jadi sponsor",
  },
  "zh-Hans": {
    title: "赞助商",
    premium: "高级赞助商",
    sponsor: "赞助商 · nubjs.com",
    pitch: "赞助 Perry，即是资助开源编译器的开发。",
    cta: "成为赞助商",
  },
};
const t = pick(copy, lang);
---

<section class="sponsors" aria-labelledby="sponsors-title">
  <div class="wrap row">
    <h2 id="sponsors-title" class="title">{t.title}</h2>

    <ul class="logos">
      <li class="sponsor" data-reveal>
        <a href="https://skelpo.com" class="logo">
          <img src="/skelpo-logo.png" width="170" height="40" alt="Skelpo" />
        </a>
        <span class="t-label muted">{t.premium}</span>
      </li>
      <li class="divider" aria-hidden="true"></li>
      <li class="sponsor" data-reveal style="--i: 1">
        <a href="https://nubjs.com" class="logo lockup">
          <img src="/nub-icon.png" width="40" height="40" alt="" />
          <span class="nub">Nub</span>
        </a>
        <span class="t-label muted">{t.sponsor}</span>
      </li>
    </ul>

    <div class="cta" data-reveal style="--i: 2">
      <p class="muted">{t.pitch}</p>
      <a class="become" href={links.sponsor}>
        <Heart size={15} stroke-width={1.75} aria-hidden="true" />
        {t.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .sponsors {
    padding-block: 64px;
    border-top: 1px solid var(--border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .title {
    width: 300px;
    flex: none;
    font-size: 17px;
    font-weight: 400;
    line-height: 25px;
  }
  .logos {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 56px;
    padding-inline: 48px;
    border-inline: 1px solid var(--border);
  }
  .sponsor {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sponsor .t-label {
    letter-spacing: 1px;
  }
  .logo {
    display: flex;
    align-items: center;
    height: 40px;
  }
  .logo img {
    height: 40px;
    width: auto;
  }
  .lockup {
    gap: 12px;
  }
  .lockup img {
    border-radius: 9px;
  }
  .nub {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.6px;
  }
  .divider {
    width: 1px;
    height: 56px;
    background: var(--border);
  }
  .cta {
    width: 320px;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .cta p {
    font-size: 15px;
    line-height: 23px;
  }
  .become {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 150ms linear;
  }
  .become:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  /* Title, logos and call-to-action only fit side by side from ~1320px. */
  @media (max-width: 1320px) {
    .row {
      flex-wrap: wrap;
      gap: 32px;
    }
    .title {
      width: 100%;
    }
    .logos {
      flex: none;
      justify-content: flex-start;
      padding-inline: 0;
      border-inline: 0;
    }
  }
  @media (max-width: 560px) {
    .logos {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }
    .divider {
      display: none;
    }
    .cta {
      width: 100%;
    }
  }
</style>
