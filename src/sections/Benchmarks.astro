}
const { lang } = Astro.props;

type Kind = "memory" | "faster";
type Headline = { value: number; kind: Kind; perry: number; node: number; unit: "MB" | "ms" };
type Row = { name: string; perry: number; node: number };

// Values from the design: Perry 0.5.1639 vs Node.js v22.23.1, Apple M1, 2026-09-23.
const headlines: Headline[] = [
  { value: 10, kind: "memory", perry: 3.5, node: 36, unit: "MB" },
  { value: 3.7, kind: "faster", perry: 39, node: 144, unit: "ms" },
  { value: 3.4, kind: "faster", perry: 354, node: 1207, unit: "ms" },
  { value: 3.2, kind: "faster", perry: 309, node: 987, unit: "ms" },
];
const rows: Row[] = [
  { name: "string concat", perry: 6, node: 31 },
  { name: "object allocation", perry: 2, node: 8 },
  { name: "array write", perry: 3, node: 9 },
  { name: "mandelbrot", perry: 25, node: 24 },
  { name: "binary trees", perry: 13, node: 6 },
  { name: "method calls", perry: 35, node: 11 },
