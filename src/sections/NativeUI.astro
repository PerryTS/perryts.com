    title: "Un'unica codebase UI,\nundici piattaforme native.",
    aside: "perry/ui è una libreria UI dichiarativa basata su stack. Ogni widget corrisponde al toolkit nativo della piattaforma: AppKit, UIKit, Win32, GTK4, Android Views o il DOM.",
    fan: "perry compile",
    toolkitsLabel: "Toolkit nativi e piattaforme coperte",
    preview: "preview",
    legend: { broad: "ampio", core: "base · lacune documentate", preview: "preview" },
    widgets: "35+ widget",
    widgetsDesc: "State(), stack, spacer.\nNiente CSS.",
  },
  ja: {
    title: "1つのUIコードで、\n11のネイティブ対応先。",
    aside: "perry/uiはスタックを基本とする宣言的UIライブラリです。各ウィジェットはプラットフォーム固有のツールキット（AppKit、UIKit、Win32、GTK4、Android Views、DOM）に対応します。",
    fan: "perry compile",
    toolkitsLabel: "ネイティブツールキットと対応プラットフォーム",
    preview: "プレビュー",
    legend: { broad: "広範", core: "コア · 未対応箇所を明記", preview: "プレビュー" },
    widgets: "35+ ウィジェット",
    widgetsDesc: "State()、スタック、スペーサー。\nCSS不要。",
  },
  ko: {
    title: "하나의 UI 코드베이스,\n11개의 네이티브 타깃.",
    aside: "perry/ui는 스택 기반의 선언형 UI 라이브러리입니다. 각 위젯은 플랫폼 고유의 툴킷인 AppKit, UIKit, Win32, GTK4, Android Views 또는 DOM에 대응합니다.",
    fan: "perry compile",
    toolkitsLabel: "네이티브 툴킷과 지원 플랫폼",
    preview: "프리뷰",
    legend: { broad: "폭넓음", core: "핵심 · 미지원 항목 문서화", preview: "프리뷰" },
    widgets: "35+ 위젯",
    widgetsDesc: "State(), 스택, 스페이서.\nCSS 없음.",
  },
  pt: {
    title: "Uma única base de código de UI,\nonze plataformas nativas.",
    aside: "perry/ui é uma biblioteca de UI declarativa baseada em stacks. Cada widget corresponde ao toolkit próprio da plataforma: AppKit, UIKit, Win32, GTK4, Android Views ou o DOM.",
    fan: "perry compile",
    toolkitsLabel: "Toolkits nativos e as plataformas que cobrem",
    preview: "preview",
    legend: { broad: "ampla", core: "básica · lacunas documentadas", preview: "preview" },
    widgets: "35+ widgets",
    widgetsDesc: "State(), stacks, spacers.\nSem CSS.",
  },
  th: {
    title: "โค้ด UI ชุดเดียว\nสิบเอ็ดแพลตฟอร์มเนทีฟ",
    aside: "perry/ui เป็นไลบรารี UI แบบ declarative ที่สร้างบน stack แต่ละวิดเจ็ตแมปไปยังทูลคิตของแพลตฟอร์มนั้นเอง ได้แก่ AppKit, UIKit, Win32, GTK4, Android Views หรือ DOM",
    fan: "perry compile",
    toolkitsLabel: "ทูลคิตเนทีฟและแพลตฟอร์มที่รองรับ",
    preview: "พรีวิว",
    legend: { broad: "ครอบคลุม", core: "พื้นฐาน · ระบุส่วนที่ขาดไว้ในเอกสาร", preview: "พรีวิว" },
    widgets: "35+ วิดเจ็ต",
    widgetsDesc: "State(), stack, spacer\nไม่ใช้ CSS",
  },
  tr: {
    title: "Tek UI kod tabanı,\non bir yerel platform.",
    aside: "perry/ui, stack'ler üzerine kurulu bildirimsel bir UI kütüphanesidir. Her widget platformun kendi araç takımına karşılık gelir: AppKit, UIKit, Win32, GTK4, Android Views veya DOM.",
    fan: "perry compile",
    toolkitsLabel: "Yerel araç takımları ve kapsadıkları platformlar",
    preview: "önizleme",
    legend: { broad: "geniş", core: "temel · eksikler belgelenmiş", preview: "önizleme" },
    widgets: "35+ widget",
    widgetsDesc: "State(), stack'ler, spacer'lar.\nCSS yok.",
  },
  vi: {
    title: "Một codebase UI,\nmười một nền tảng gốc.",
    aside: "perry/ui là thư viện UI khai báo dựa trên stack. Mỗi widget ánh xạ tới bộ công cụ riêng của nền tảng: AppKit, UIKit, Win32, GTK4, Android Views hoặc DOM.",
    fan: "perry compile",
    toolkitsLabel: "Bộ công cụ gốc và các nền tảng tương ứng",
    preview: "preview",
    legend: { broad: "rộng", core: "cốt lõi · đã ghi rõ phần còn thiếu", preview: "preview" },
    widgets: "35+ widget",
    widgetsDesc: "State(), stack, spacer.\nKhông CSS.",
  },
  id: {
    title: "Satu codebase UI,\nsebelas platform native.",
    aside: "perry/ui adalah library UI deklaratif berbasis stack. Setiap widget dipetakan ke toolkit bawaan platform: AppKit, UIKit, Win32, GTK4, Android Views, atau DOM.",
    fan: "perry compile",
    toolkitsLabel: "Toolkit native dan platform yang dicakupnya",
    preview: "preview",
    legend: { broad: "luas", core: "inti · kekurangan terdokumentasi", preview: "preview" },
    widgets: "35+ widget",
    widgetsDesc: "State(), stack, spacer.\nTanpa CSS.",
  },
  "zh-Hans": {
    title: "一套 UI 代码，\n十一个原生平台。",
    aside: "perry/ui 是基于 stack 的声明式 UI 库。每个组件都映射到平台自身的工具包：AppKit、UIKit、Win32、GTK4、Android Views 或 DOM。",
    fan: "perry compile",
    toolkitsLabel: "原生工具包及其覆盖的平台",
    preview: "预览",
    legend: { broad: "广泛", core: "核心 · 已记录差距", preview: "预览" },
    widgets: "35+ 组件",
    widgetsDesc: "State()、stack、spacer。\n无需 CSS。",
  },
};
const t = pick(copy, lang);

// Toolkit names and platforms are product names: not translated.
const toolkits: { name: string; platforms: [string, Coverage][]; preview?: boolean }[] = [
  { name: "AppKit", platforms: [["macOS", "broad"]] },
  { name: "UIKit", platforms: [["iOS", "broad"], ["iPadOS", "broad"], ["tvOS", "broad"], ["visionOS", "core"]] },
  { name: "SwiftUI", platforms: [["watchOS", "core"]] },
  { name: "Android Views", platforms: [["Android", "broad"], ["Wear OS", "core"]] },
  { name: "Win32", platforms: [["Windows", "broad"]] },
  { name: "GTK4", platforms: [["Linux", "broad"]] },
  { name: "DOM", platforms: [["Web / WASM", "broad"]] },
  { name: "ArkUI", platforms: [["HarmonyOS", "preview"]], preview: true },
];

const widgets = [
  "VStack", "HStack", "ZStack", "Spacer", "Text", "Button", "TextField", "SecureField", "Toggle", "Slider", "Picker",
  "WheelPicker", "ImageFile", "ImageSymbol", "ProgressView", "TextArea", "Section", "State", "…",
];

// Source from docs/examples/ui/overview/quickstart.ts, tokenized by hand: [class, text].
type Tok = [string, string];
const code: Tok[][] = [
  [["kw", "import"], ["", " { App, Text, VStack } "], ["kw", "from"], ["", " "], ["str", '"perry/ui"']],
  [],
  [["fn", "App"], ["", "({"]],
  [["", "    title: "], ["str", '"My App"'], ["", ","]],
  [["", "    width: "], ["num", "400"], ["", ","]],
  [["", "    height: "], ["num", "300"], ["", ","]],
  [["", "    body: "], ["type", "VStack"], ["", "("], ["num", "16"], ["", ", ["]],
  [["", "        "], ["type", "Text"], ["", "("], ["str", '"Hello from Perry!"'], ["", "),"]],
  [["", "    ]),"]],
  [["", "})"]],
];
---

<section class="section native">
  <div class="wrap">
    <SectionHeader title={t.title} aside={t.aside} />

    <div class="map">
      <figure class="editor" data-reveal>
        <figcaption class="tabs">
          <span class="tab">app.ts</span>
          <span class="src">docs/examples/ui/overview/quickstart.ts</span>
        </figcaption>
        <div class="code">
          <span class="gutter" aria-hidden="true">{code.map((_, i) => `${i + 1}\n`)}</span>
          <pre><code>{code.map((line) => (<>{line.map(([cls, text]) => (cls ? <span class={cls}>{text}</span> : text))}{"\n"}</>))}</code></pre>
        </div>
        <p class="cmd">$ perry compile app.ts --target &lt;any of 11&gt;</p>
      </figure>

      <div class="fan" aria-hidden="true">
        <span class="rule"></span>
        <span class="fan-label">{t.fan}</span>
      </div>

      <div class="toolkits">
        <ul aria-label={t.toolkitsLabel} data-cycle="loop" data-cycle-interval="1400">
          {toolkits.map((tk, i) => (
            <li class:list={["toolkit", { "is-preview": tk.preview }]} data-reveal data-cycle-item={tk.preview ? undefined : ""} style={`--i: ${i}`}>
              <span class="tk-name">{tk.name}</span>
              <span class="platforms">
                {tk.platforms.map(([p, cov], j) => (
                  <>
                    {j > 0 && <span class="sep" aria-hidden="true">·</span>}
                    <span class={`plat plat--${cov}`}>{cov === "preview" ? `${p} · ${t.preview}` : p}</span>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
        <ul class="legend">
          {(Object.keys(t.legend) as Coverage[]).map((k) => (
            <li><span class={`sq sq--${k}`} aria-hidden="true"></span>{t.legend[k]}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="widgets">
      <div class="widgets-label">
        <h3 class="widgets-title">{t.widgets}</h3>
        <p class="widgets-desc"><Lines text={t.widgetsDesc} /></p>
      </div>
      <ul class="widget-list">
        {widgets.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .native {
    padding-block: calc(var(--section-y) + 8px);
  }
  .map {
    margin-top: 64px;
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(96px, 1fr) minmax(0, 460px);
    align-items: center;
  }

  /* Editor */
  .editor {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    overflow: hidden;
    font-family: var(--font-mono);
  }
  .tabs {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
    border-bottom: 1px solid var(--border);
  }
  .tab {
    flex: none;
    padding: 12px 20px;
    border-bottom: 2px solid var(--accent);
    margin-bottom: -1px;
    font-size: 13px;
  }
  .src {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
  }
  .code {
    display: flex;
    padding: 24px 0 28px;
    font-size: 15px;
    line-height: 29px;
  }
  .gutter {
    flex: none;
    padding: 0 20px;
    text-align: right;
    white-space: pre;
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
  }
  .code pre {
    flex: 1;
    min-width: 0;
    padding-right: 20px;
    overflow-x: auto;
    font: inherit;
  }
  .kw {
    color: var(--pixel-amber);
  }
  .str {
    color: var(--success);
  }
  .fn {
    color: color-mix(in srgb, var(--text) 85%, var(--text-muted));
  }
  .num {
    color: var(--pixel-pink);
  }
  .type {
    color: var(--pixel-blue);
  }
  .cmd {
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-size: 13px;
    white-space: nowrap;
    overflow-x: auto;
  }

  /* Fan between editor and toolkits */
  .fan {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 0 24px;
  }
  .rule {
    width: 100%;
    height: 1px;
    background: var(--border);
  }
  .fan-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  /* Toolkits */
  .toolkits > ul:first-child {
    border-top: 1px solid var(--border);
  }
  .toolkit {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
  }
  .toolkit.is-preview {
    border-bottom: 0;
  }
  .tk-name {
    transition: color 300ms linear;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.023em;
  }
  /* One codebase, many toolkits: the highlight walks through them while visible (data-cycle). */
  .toolkit.is-current .tk-name {
    color: var(--accent);
  }
  .is-preview .tk-name {
    color: var(--text-muted);
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 10px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .sep {
    color: var(--border);
  }
  .plat--core {
    color: var(--accent);
  }
  .plat--preview {
    color: var(--text-muted);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sq {
    width: 8px;
    height: 8px;
  }
  .sq--broad {
    background: var(--text);
  }
  .sq--core {
    background: var(--accent);
  }
  .sq--preview {
    background: var(--text-muted);
  }

  /* Widgets */
  .widgets {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 32px;
  }
  .widgets-label {
    flex: none;
    width: 240px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .widgets-title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.023em;
  }
  .widgets-desc {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--text-muted);
  }
  .widget-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 27px;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 27px;
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .map {
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 24px;
    }
    .editor {
      max-width: 640px;
    }
    .fan {
      flex-direction: row;
      padding: 0;
    }
    .fan .rule {
      flex: 1;
    }
    .fan::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border);
    }
  }
  @media (max-width: 900px) {
    .widgets {
      flex-direction: column;
      gap: 20px;
    }
  }
  @media (max-width: 480px) {
    .code {
      font-size: 13px;
      line-height: 24px;
    }
    .gutter {
      padding: 0 12px;
    }
    .toolkit {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .platforms {
      justify-content: flex-start;
    }
  }
</style>
