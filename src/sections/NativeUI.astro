---
import { pick, type Copy, type Locale } from "../i18n/index.ts";
import SectionHeader from "../components/SectionHeader.astro";
import Lines from "../components/Lines.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

type Coverage = "broad" | "core" | "preview";
const copy: Copy<{
  title: string;
  aside: string;
  fan: string;
  toolkitsLabel: string;
  preview: string;
  legend: Record<Coverage, string>;
  widgets: string;
  widgetsDesc: string;
}> = {
  en: {
    title: "One UI codebase,\neleven native targets.",
    aside: "perry/ui is a declarative UI library built on stacks. Each widget maps to the platform's own toolkit: AppKit, UIKit, Win32, GTK4, Android Views or the DOM.",
    fan: "perry compile",
    toolkitsLabel: "Native toolkits and the platforms they cover",
    preview: "preview",
    legend: { broad: "broad", core: "core · gaps documented", preview: "preview" },
    widgets: "35+ widgets",
    widgetsDesc: "State(), stacks, spacers.\nNo CSS.",
