    fan: "perry compile",
    toolkitsLabel: "Native Toolkits und die Plattformen, die sie abdecken",
    preview: "Preview",
    legend: { broad: "breit", core: "Kern · Lücken dokumentiert", preview: "Preview" },
    widgets: "35+ Widgets",
    widgetsDesc: "State(), Stacks, Spacer.\nKein CSS.",
  },
  fr: {
    title: "Une seule base de code UI,\nonze plateformes natives.",
    aside: "perry/ui est une bibliothèque d'UI déclarative fondée sur des stacks. Chaque widget correspond au toolkit propre à la plateforme : AppKit, UIKit, Win32, GTK4, Android Views ou le DOM.",
    fan: "perry compile",
    toolkitsLabel: "Toolkits natifs et plateformes couvertes",
    preview: "preview",
    legend: { broad: "large", core: "de base · lacunes documentées", preview: "preview" },
    widgets: "35+ widgets",
    widgetsDesc: "State(), stacks, spacers.\nSans CSS.",
  },
