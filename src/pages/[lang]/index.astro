---
import Base from "../../layouts/Base.astro";
import Landing from "../../components/Landing.astro";
import JsonLd from "../../components/JsonLd.astro";
import { localeStaticPaths, pick, type Copy, type Locale } from "../../i18n/index.ts";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const copy: Copy<{ title: string; description: string }> = {
  en: {
    title: "Perry — TypeScript compiled to native",
    description: "Perry is an open-source, ahead-of-time TypeScript compiler. One codebase, 11 platforms, no Node.js at runtime.",
  },
  es: {
    title: "Perry — TypeScript compilado a nativo",
    description: "Perry es un compilador de TypeScript ahead-of-time y de código abierto. Un código, 11 plataformas, sin Node.js en ejecución.",
  },
  de: {
    title: "Perry — TypeScript, nativ kompiliert",
    description: "Perry ist ein quelloffener Ahead-of-Time-Compiler für TypeScript. Eine Codebasis, 11 Plattformen, kein Node.js zur Laufzeit.",
  },
  fr: {
    title: "Perry — TypeScript compilé en natif",
    description: "Perry est un compilateur TypeScript ahead-of-time et open source. Une seule base de code, 11 plateformes, sans Node.js à l'exécution.",
  },
  it: {
    title: "Perry — TypeScript compilato in nativo",
    description: "Perry è un compilatore TypeScript ahead-of-time e open source. Un'unica codebase, 11 piattaforme, nessun Node.js a runtime.",
  },
  ja: {
    title: "Perry — TypeScriptをネイティブにコンパイル",
    description: "Perryはオープンソースのahead-of-time TypeScriptコンパイラです。1つのコードベースで11プラットフォームに対応し、実行時にNode.jsは不要です。",
  },
  ko: {
    title: "Perry — 네이티브로 컴파일되는 TypeScript",
    description: "Perry는 오픈 소스 ahead-of-time TypeScript 컴파일러입니다. 하나의 코드베이스, 11개 플랫폼, 런타임에 Node.js가 필요 없습니다.",
  },
  pt: {
    title: "Perry — TypeScript compilado para nativo",
    description: "Perry é um compilador de TypeScript ahead-of-time e de código aberto. Uma única base de código, 11 plataformas, sem Node.js em tempo de execução.",
  },
  th: {
    title: "Perry — คอมไพล์ TypeScript เป็นเนทีฟ",
    description: "Perry คือคอมไพเลอร์ TypeScript แบบ ahead-of-time ที่เป็นโอเพนซอร์ส โค้ดเบสเดียว 11 แพลตฟอร์ม ไม่ต้องใช้ Node.js ขณะรัน",
  },
  tr: {
    title: "Perry — Yerel koda derlenen TypeScript",
    description: "Perry, açık kaynaklı ve ahead-of-time çalışan bir TypeScript derleyicisidir. Tek kod tabanı, 11 platform, çalışma zamanında Node.js yok.",
  },
  vi: {
    title: "Perry — TypeScript biên dịch thành mã gốc",
    description: "Perry là trình biên dịch TypeScript ahead-of-time mã nguồn mở. Một codebase, 11 nền tảng, không cần Node.js khi chạy.",
  },
  id: {
    title: "Perry — TypeScript dikompilasi ke native",
    description: "Perry adalah compiler TypeScript ahead-of-time yang open source. Satu codebase, 11 platform, tanpa Node.js saat runtime.",
  },
  "zh-Hans": {
    title: "Perry — 将 TypeScript 编译为原生",
    description: "Perry 是开源的 ahead-of-time TypeScript 编译器。一套代码，11 个平台，运行时无需 Node.js。",
  },
};
const t = pick(copy, lang);

// Same structured data the previous home page emitted.
const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Perry",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux, iOS, iPadOS, visionOS, tvOS, watchOS, Android, Wear OS, Web/WebAssembly",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Perry compiles TypeScript ahead of time to native executables. Native builds need no external Node.js installation or JavaScript engine; Perry's runtime and GC are statically linked.",
  url: "https://perryts.com/en/",
  sameAs: ["https://github.com/PerryTS/perry", "https://docs.perryts.com"],
};
---

<Base lang={lang} title={t.title} description={t.description} titleIsAbsolute>
  <JsonLd slot="head" data={softwareApplication} />
  <Landing lang={lang} />
</Base>
