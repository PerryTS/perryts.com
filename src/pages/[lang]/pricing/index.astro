    "selfHostTitle": "What is open source and self-hostable today?",
    "selfHostDescription": "The Perry compiler and runtime in the linked repository are MIT licensed. That repository includes publish and verification clients plus configurable endpoints, but it does not include a complete public hub, verification service, or worker deployment. Perry therefore does not currently advertise “clone one repo and self-host everything.”",
    "faqTitle": "Pertanyaan",
    "q1": "Does local compilation require an account?",
    "a1": "No. Installing Perry and compiling on your own machine does not require a Perry account.",
    "q2": "What are the hosted quotas and prices?",
    "a2": "They are not promised on this page. Confirm current availability, limits, and charges in the hosted service or in writing before relying on them.",
    "q3": "Can I self-host the complete publish service?",
    "a3": "Not from the Perry compiler repository alone. Custom endpoints are supported by the client, but a complete public hub and worker deployment is not currently included there."
  },
  "zh-Hans": {
    "title": "Perry pricing and availability",
    "subtitle": "The compiler and local build workflow are free and MIT licensed. Hosted build, signing, verification, and support are separate services whose availability and terms must be confirmed.",
    "localTitle": "Compiler and local builds",
    "localDescription": "Use Perry locally without an account or usage fee.",
    "localFeature1": "MIT-licensed compiler and runtime",
    "localFeature2": "Local compile, run, check, doctor, and verify workflows",
    "localFeature3": "No hosted-service quota for work performed on your own machine",
    "viewSource": "View source and license",
    "hostedAvailability": "Availability varies",
    "hostedTitle": "Hosted Perry Publish",
    "hostedDescription": "The CLI contains publish clients and workflows. Hosted platform coverage, quotas, pricing, queue priority, and overages are confirmed in the service before purchase.",
    "hostedFeature1": "Build and packaging workflows for supported targets",
    "hostedFeature2": "Signing and store submission when credentials and platform prerequisites are configured",
    "hostedFeature3": "Verification depth depends on the selected target and hosted environment",
    "publishDetails": "Read how publish works",
    "needTermsTitle": "Need hosted builds or a support agreement?",
    "needTermsDescription": "Contact the Perry team for current availability, platform coverage, pricing, and written service terms.",
    "contact": "Contact the team",
    "languageNotice": "技术事实和测量说明以英文为准，以避免不同翻译之间出现偏差。",
    "selfHostTitle": "What is open source and self-hostable today?",
    "selfHostDescription": "The Perry compiler and runtime in the linked repository are MIT licensed. That repository includes publish and verification clients plus configurable endpoints, but it does not include a complete public hub, verification service, or worker deployment. Perry therefore does not currently advertise “clone one repo and self-host everything.”",
    "faqTitle": "常见问题",
    "q1": "Does local compilation require an account?",
    "a1": "No. Installing Perry and compiling on your own machine does not require a Perry account.",
    "q2": "What are the hosted quotas and prices?",
    "a2": "They are not promised on this page. Confirm current availability, limits, and charges in the hosted service or in writing before relying on them.",
    "q3": "Can I self-host the complete publish service?",
    "a3": "Not from the Perry compiler repository alone. Custom endpoints are supported by the client, but a complete public hub and worker deployment is not currently included there."
  },
};
const t = pick(copy, lang);
const faq = [
  { q: t.q1, a: t.a1 },
  { q: t.q2, a: t.a2 },
  { q: t.q3, a: t.a3 },
];
---

<Base lang={lang} title={t.title} description={t.subtitle} path="pricing" canonical="/en/pricing/" alternates={["en"]}>
  <PageHeader title={t.title} lead={t.subtitle}>
    {lang !== "en" && <Fragment slot="above"><Notice>{t.languageNotice}</Notice></Fragment>}
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <div class="plans">
        <article class="plan" data-reveal>
          <Tag>MIT</Tag>
          <h2 class="t-h3">{t.localTitle}</h2>
          <p class="muted">{t.localDescription}</p>
          <CheckList items={[t.localFeature1, t.localFeature2, t.localFeature3]} />
          <Button href={links.github} variant="secondary">{t.viewSource}</Button>
        </article>
        <article class="plan" data-reveal style="--i: 1">
          <Tag>{t.hostedAvailability}</Tag>
          <h2 class="t-h3">{t.hostedTitle}</h2>
          <p class="muted">{t.hostedDescription}</p>
          <CheckList items={[t.hostedFeature1, t.hostedFeature2, t.hostedFeature3]} />
          <Button href={localePath(lang, "publish")}>{t.publishDetails}</Button>
        </article>
      </div>

      <div class="self-host" data-reveal>
        <h2 class="t-label accent">{t.selfHostTitle}</h2>
        <p class="t-lead">{t.selfHostDescription}</p>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap faq-wrap">
      <h2 class="t-h2" data-reveal>{t.faqTitle}</h2>
      <dl class="faq">
        {faq.map((item, i) => (
          <div class="faq__item" data-reveal style={`--i: ${i}`}>
            <dt>{item.q}</dt>
            <dd class="muted">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact" data-reveal>
      <div>
        <h2 class="t-h3">{t.needTermsTitle}</h2>
        <p class="muted">{t.needTermsDescription}</p>
      </div>
      <Button href={`mailto:${CONTACT_EMAIL}`}><Mail size={16} stroke-width={1.75} aria-hidden="true" />{t.contact}</Button>
    </div>
  </section>
</Base>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .plan {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 40px;
  }
  .plan + .plan {
    border-left: 1px solid var(--border);
  }
  .plan :global(.list) {
    flex: 1;
  }
  .self-host {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 880px;
    margin-top: 64px;
  }
  .faq-wrap {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .faq {
    border-top: 1px solid var(--border);
  }
  .faq__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 24px;
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-size: 18px;
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .contact > div {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
  }
  @media (max-width: 900px) {
    .plans,
    .faq-wrap {
      grid-template-columns: 1fr;
    }
    .faq-wrap {
      gap: 32px;
    }
    .plan + .plan {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .contact {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 640px) {
    .plan {
      padding: 28px 20px;
    }
  }
</style>
