---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import FactsNotice from "../../../components/guides/FactsNotice.astro";
import ShowcaseCard from "../../../components/showcase/ShowcaseCard.astro";
import { messages } from "../../../i18n/messages.ts";
import { localeStaticPaths, type Locale } from "../../../i18n/index.ts";
import { showcaseProjects } from "../../../data/showcase.ts";

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = messages(lang).showcase.showcase;
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription} path="showcase">
  <PageHeader title={t.title} lead={t.subtitle}>
    <FactsNotice slot="above" lang={lang} />
  </PageHeader>
  <section class="section">
    <div class="wrap">
      <ul class="grid">
        {showcaseProjects.map((project, i) => <ShowcaseCard lang={lang} project={project} index={i} />)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }
</style>
