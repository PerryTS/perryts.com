    "retentionBody": "Skelpo, its hosting and analytics infrastructure, and Resend receive only the data needed for the purposes above. Operational logs are kept according to the relevant service configuration; newsletter contacts remain until unsubscribe or deletion. Contact us for the current retention setting or deletion.",
    "rightsTitle": "7. Your rights",
    "rightsItems": [
      "Request access, correction, deletion, restriction, or portability where applicable.",
      "Object to processing based on legitimate interests.",
      "Withdraw newsletter consent at any time without affecting earlier lawful processing.",
      "Complain to a competent data-protection supervisory authority."
    ],
    "contactTitle": "8. Contact",
    "contactBody": "For privacy questions or requests, contact",
    "languageNotice": "Fakta teknis dan catatan pengukuran dipelihara dalam bahasa Inggris untuk mencegah perbedaan antar-terjemahan."
  },
  "zh-Hans": {
    "metaTitle": "Privacy notice",
    "metaDescription": "How perryts.com handles analytics and newsletter subscriptions.",
    "title": "Privacy notice",
    "updated": "Last updated: August 27, 2026",
    "controllerTitle": "1. Controller",
    "controllerBody": "Skelpo GmbH, Köttingstraße 41, 58339 Breckerfeld, Germany, operates this website and is responsible for the processing described here.",
    "dataTitle": "2. Data processed",
    "dataItems": [
      "Page-view and technical request data produced when you visit the site.",
      "Your email address and the source form when you choose to subscribe to the newsletter."
    ],
    "analyticsTitle": "3. Analytics",
    "analyticsBody": "The site loads a Plausible analytics script from pa.skelpo.com to measure page views and understand aggregate site use. The application code does not set an advertising cookie. Technical request data may still be processed by the analytics and hosting infrastructure.",
    "newsletterTitle": "4. Newsletter and Resend",
    "newsletterBody": "When you submit the newsletter form, the site sends your email address and a short source label to a server-side subscription endpoint. That endpoint forwards the email address to Resend and the configured Resend audience. The address is used for the requested Perry newsletter and remains there until you unsubscribe, request deletion, or the configured audience is removed.",
    "purposesTitle": "5. Purposes and legal bases",
    "purposesItems": [
      "Operate, secure, and diagnose the website and its supporting services.",
      "Measure aggregate use and improve the website based on a legitimate interest in operating the service.",
      "Send the newsletter after your request or consent."
    ],
    "retentionTitle": "6. Retention and recipients",
    "retentionBody": "Skelpo, its hosting and analytics infrastructure, and Resend receive only the data needed for the purposes above. Operational logs are kept according to the relevant service configuration; newsletter contacts remain until unsubscribe or deletion. Contact us for the current retention setting or deletion.",
    "rightsTitle": "7. Your rights",
    "rightsItems": [
      "Request access, correction, deletion, restriction, or portability where applicable.",
      "Object to processing based on legitimate interests.",
      "Withdraw newsletter consent at any time without affecting earlier lawful processing.",
      "Complain to a competent data-protection supervisory authority."
    ],
    "contactTitle": "8. Contact",
    "contactBody": "For privacy questions or requests, contact",
    "languageNotice": "技术事实和测量说明以英文为准，以避免不同翻译之间出现偏差。"
  },
};
const t = pick(copy, lang);
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription} path="privacy" canonical="/en/privacy/" alternates={["en"]}>
  <PageHeader title={t.title} lead={t.updated}>
    {lang !== "en" && <Fragment slot="above"><Notice>{t.languageNotice}</Notice></Fragment>}
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <Prose class="legal">
        <h2>{t.controllerTitle}</h2>
        <p>{t.controllerBody}</p>
        <h2>{t.dataTitle}</h2>
        <ul>{t.dataItems.map((item) => <li>{item}</li>)}</ul>
        <h2>{t.analyticsTitle}</h2>
        <p>{t.analyticsBody}</p>
        <h2>{t.newsletterTitle}</h2>
        <p>{t.newsletterBody}</p>
        <h2>{t.purposesTitle}</h2>
        <ul>{t.purposesItems.map((item) => <li>{item}</li>)}</ul>
        <h2>{t.retentionTitle}</h2>
        <p>{t.retentionBody}</p>
        <h2>{t.rightsTitle}</h2>
        <ul>{t.rightsItems.map((item) => <li>{item}</li>)}</ul>
        <h2>{t.contactTitle}</h2>
        <p>{t.contactBody} <a href="mailto:info@skelpo.com">info@skelpo.com</a>.</p>
      </Prose>
    </div>
  </section>
</Base>

<style>
  .wrap :global(.legal) {
    max-width: 760px;
  }
  .wrap :global(.legal > h2:first-child) {
    margin-top: 0;
  }
</style>
