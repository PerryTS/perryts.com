---
export interface TerminalLine {
  text: string;
  /** Prefix with a "$" prompt. */
  prompt?: boolean;
  tone?: "text" | "muted" | "success" | "accent";
}
interface Props {
  title: string;
  meta?: string;
  lines: TerminalLine[];
  class?: string;
}
const { title, meta, lines, class: className } = Astro.props;
---

<figure class:list={["terminal", className]}>
  <figcaption class="bar t-mono">
    <span>{title}</span>
    {meta && <span>{meta}</span>}
  </figcaption>
  <pre class="body" data-typing>{lines.map((l) => (
    <span class:list={["line", l.tone ?? "text"]} data-line>{l.prompt && <span class="prompt">$ </span>}{l.text === "█" ? <span class="cursor">█</span> : l.text}{"\n"}</span>
  ))}</pre>
</figure>

<style>
  .terminal {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    overflow: hidden;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }
  .body {
    padding: 22px 22px 26px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 23px;
    white-space: pre;
    overflow-x: auto;
  }
  .prompt,
  .accent {
    color: var(--accent);
  }
  .muted {
    color: var(--text-muted);
  }
  .success {
    color: var(--success);
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
