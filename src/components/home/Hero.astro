---
import { type Locale } from "../../i18n/index.ts";
import Lines from "../Lines.astro";
import InstallCommand from "../InstallCommand.astro";
import LinkArrow from "../LinkArrow.astro";
import Terminal, { type TerminalLine } from "../Terminal.astro";
import { links } from "../../lib/links.ts";
import { messages } from "../../i18n/messages.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const t = messages(lang).home.hero;

// Terminal output is product output, not copy: it stays the same in every locale.
const lines: TerminalLine[] = [
  { text: "perry compile main.ts", prompt: true },
  { text: "  parse      swc", tone: "muted" },
  { text: "  transform  hir", tone: "muted" },
  { text: "  codegen    llvm", tone: "muted" },
  { text: "  link       runtime + gc", tone: "muted" },
  { text: "✓ wrote ./main   ~330 KB", tone: "success" },
  { text: "./main", prompt: true },
  { text: "Hello, World!" },
  { text: "█", prompt: true, tone: "accent" },
];
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>{t.eyebrow}</p>
      <h1 class="t-display" data-reveal style="--i: 1"><Lines text={t.title} /></h1>
      <p class="t-lead muted sub" data-reveal style="--i: 2">{t.sub}</p>
      <div class="ctas" data-reveal style="--i: 3">
        <InstallCommand command="npm i -g @perryts/perry" copyLabel={t.copyLabel} />
        <LinkArrow href={links.docs} external={false} class="docs">{t.docs}</LinkArrow>
      </div>
    </div>
    <Terminal class="hero__terminal" title="~/hello" meta="zsh" lines={lines} />
  </div>
</section>

<style>
  .hero {
    padding-block: 96px 72px;
  }
  .hero__inner {
    display: flex;
    align-items: flex-end;
    gap: 64px;
  }
  .hero__copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.09em;
    color: var(--accent);
  }
  .sub {
    max-width: 480px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .ctas :global(.docs) {
    padding: 16px 8px;
  }
  .hero :global(.hero__terminal) {
    flex: none;
    width: 520px;
  }
  @media (max-width: 1100px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 48px;
    }
    .hero :global(.hero__terminal) {
      width: 100%;
      max-width: 560px;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-block: 40px 48px;
    }
    .eyebrow {
      font-size: 11px;
      letter-spacing: 0.06em;
      text-wrap: balance;
    }
    .ctas {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .ctas :global(.install) {
      width: 100%;
      justify-content: space-between;
    }
    .ctas :global(.docs) {
      padding: 12px 0;
    }
  }
</style>
