---
import CopyButton from "../CopyButton.astro";
import Lines from "../Lines.astro";
import PixelWall from "../PixelWall.astro";
import { pick, type Copy, type Locale } from "../../i18n/index.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

