    ],
  },
  de: {
    title: "Perry\ninstallieren.",
    copy: "Befehl kopieren",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["Jedes OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["Danach", "perry init my-app && perry run ."],
    ],
  },
  fr: {
    title: "Installez\nPerry.",
    copy: "Copier la commande",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["Tout OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["Ensuite", "perry init my-app && perry run ."],
    ],
  },
  it: {
    title: "Installa\nPerry.",
    copy: "Copia comando",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["Qualsiasi OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["Poi", "perry init my-app && perry run ."],
    ],
  },
  ja: {
    title: "Perryを\nインストール。",
    copy: "コマンドをコピー",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["全OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["次に", "perry init my-app && perry run ."],
    ],
  },
  ko: {
    title: "Perry\n설치하기.",
    copy: "명령어 복사",
    rows: [
