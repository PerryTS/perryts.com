      ["Windows", "winget install PerryTS.Perry"],
      ["Ardından", "perry init my-app && perry run ."],
    ],
  },
  vi: {
    title: "Cài đặt\nPerry.",
    copy: "Sao chép lệnh",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["Mọi OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["Sau đó", "perry init my-app && perry run ."],
    ],
  },
  id: {
    title: "Instal\nPerry.",
    copy: "Salin perintah",
    rows: [
      ["macOS", "brew install perryts/perry/perry"],
      ["Semua OS", "npm i -g @perryts/perry"],
      ["Windows", "winget install PerryTS.Perry"],
      ["Lalu", "perry init my-app && perry run ."],
    ],
  },
  "zh-Hans": {
    title: "安装\nPerry。",
    copy: "复制命令",
