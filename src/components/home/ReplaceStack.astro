---
import { type Locale } from "../../i18n/index.ts";
import { localePath } from "../../i18n/index.ts";
import Lines from "../Lines.astro";
import LinkArrow from "../LinkArrow.astro";
import { messages } from "../../i18n/messages.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface Column {
  name: string;
  sub: string;
}
interface Row {
  key: string;
  values: [string, string, string];
}

const t = messages(lang).home.replaceStack;
---

<section class="section replace">
  <div class="wrap">
    <header class="head">
      <h2 class="t-h1" data-reveal><Lines text={t.title} /></h2>
      <p class="sub muted" data-reveal style="--i: 1">{t.sub}</p>
    </header>

    <div class="scroll">
      <table class="compare">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <td class="key"></td>
            {t.columns.map((c, i) => (
              <th scope="col" class:list={["col", { perry: i === 2 }]}>
                <span class="name">{c.name}</span>
                <span class="col-sub">{c.sub}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {t.rows.map((r, i) => (
            <tr data-reveal style={`--i: ${i}`}>
              <th scope="row" class="key t-label">{r.key}</th>
              {r.values.map((v, j) => <td class:list={{ perry: j === 2 }} data-label={t.columns[j].name}>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <footer class="foot">
      <p class="muted">{t.note}</p>
      <LinkArrow href={localePath(lang, "compare")}>{t.link}</LinkArrow>
    </footer>
  </div>
</section>

<style>
  .replace {
    padding-top: calc(var(--section-y) + 16px);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1000px;
  }
  .sub {
    max-width: 720px;
    font-size: 19px;
    line-height: 29px;
  }
  .scroll {
    margin-top: 72px;
    overflow-x: auto;
  }
  .compare {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }
  .compare th,
  .compare td {
    padding: 20px 28px;
    vertical-align: top;
    font-weight: inherit;
  }
  .compare .key {
    width: 260px;
    padding: 22px 0;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
  .compare .col {
    padding: 24px 28px;
    vertical-align: bottom;
  }
  .name {
    display: block;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.023em;
  }
  .col-sub {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  thead .perry {
    background: var(--accent);
    color: var(--bg);
    border-radius: 6px 6px 0 0;
  }
  thead .perry .col-sub {
    color: color-mix(in srgb, var(--accent-strong) 70%, var(--bg));
  }
  tbody tr {
    border-top: 1px solid var(--border);
  }
  tbody td {
    font-size: 16px;
    line-height: 23px;
    color: var(--text-muted);
  }
  tbody .perry {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-inline: 1px solid var(--accent);
    color: var(--text);
    font-weight: 500;
  }
  tbody tr:last-child .perry {
    border-bottom: 1px solid var(--accent);
  }
  .foot {
    margin-top: 72px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .scroll {
      margin-top: 48px;
    }
    .compare .key {
      width: 180px;
    }
    .compare th,
    .compare td {
      padding-inline: 20px;
    }
    .compare .key {
      padding-inline: 0 16px;
    }
    .foot {
      margin-top: 48px;
    }
  }
  /* Phones: each row becomes a small card listing the three stacks, so Perry is never off-screen. */
  @media (max-width: 640px) {
    .compare,
    .compare tbody,
    .compare tr,
    .compare th,
    .compare td {
      display: block;
      width: auto;
    }
    .compare {
      min-width: 0;
    }
    .compare thead {
      display: none;
    }
    .compare tr {
      padding-block: 16px;
      border-bottom: 1px solid var(--border);
    }
    .compare th,
    .compare td,
    .compare .key {
      padding: 0;
      border: 0;
      background: none;
    }
    .compare .key {
      margin-bottom: 8px;
    }
    .compare td {
      display: grid;
      grid-template-columns: 104px 1fr;
      gap: 10px;
      padding-block: 3px;
      font-size: 14px;
      line-height: 1.45;
    }
    .compare td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      padding-top: 3px;
    }
    .compare td.perry {
      margin-top: 6px;
      padding: 8px 10px;
      font-size: 15px;
      border-left: 2px solid var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      color: var(--text);
    }
    .compare td.perry::before {
      color: var(--accent);
    }
  }
</style>
