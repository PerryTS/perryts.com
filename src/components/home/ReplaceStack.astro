      <p class="sub muted" data-reveal style="--i: 1">{t.sub}</p>
    </header>

    <div class="scroll">
      <table class="compare">
        <caption class="sr-only">{t.caption}</caption>
        <thead>
          <tr>
            <td class="key"></td>
            {t.columns.map((c, i) => (
              <th scope="col" class:list={["col", { perry: i === 2 }]}>
                <span class="name">{c.name}</span>
                <span class="col-sub">{c.sub}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {t.rows.map((r, i) => (
            <tr data-reveal style={`--i: ${i}`}>
              <th scope="row" class="key t-label">{r.key}</th>
              {r.values.map((v, j) => <td class:list={{ perry: j === 2 }} data-label={t.columns[j].name}>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <footer class="foot">
      <p class="muted">{t.note}</p>
      <LinkArrow href={localePath(lang, "compare")}>{t.link}</LinkArrow>
    </footer>
  </div>
</section>

