---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { locales, localePath, type Locale } from "../i18n/index.ts";
import { DEFAULT_SOCIAL_IMAGE, metaDescription, pageTitle, socialImageUrl } from "../lib/seo.ts";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Page path without locale prefix, used for alternates and the language switcher. */
  path?: string;
  /** Render the title as-is instead of "<title> — Perry". */
  titleIsAbsolute?: boolean;
  /** Override the canonical URL (e.g. English-only pages point to /en/). */
  canonical?: string;
  /** Locales this page really exists in; defaults to all. Drives hreflang alternates. */
  alternates?: readonly Locale[];
  /** Absolute or root-relative social image; defaults to the site-wide preview. */
  image?: string;
  type?: "website" | "article";
  /** ISO date for articles (article:published_time; also read by the sitemap for lastmod). */
  publishedTime?: string;
  /** Keep the page out of search results (404). Drops canonical and alternates. */
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  path = "",
  titleIsAbsolute = false,
  canonical,
  alternates = locales,
  image = DEFAULT_SOCIAL_IMAGE,
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;
const fullTitle = pageTitle(title, titleIsAbsolute);
const descriptionText = metaDescription(description);
const socialTitle = fullTitle.replaceAll("JavaScript/TypeScript", "TypeScript/JavaScript");
const socialDescription = descriptionText.replaceAll("JavaScript/TypeScript", "TypeScript/JavaScript");
const canonicalUrl = new URL(canonical ?? localePath(lang, path), Astro.site);
const imageUrl = socialImageUrl(image, Astro.site);
const ogLocale = lang.replace("-", "_");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={descriptionText} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && alternates.length > 1 && alternates.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />)}
    {!noindex && alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", path), Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="Perry Blog" href={`${localePath(lang, "blog")}rss.xml`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/perry-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content="Perry" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    {image === DEFAULT_SOCIAL_IMAGE && <meta property="og:image:alt" content="Your TypeScript/JavaScript, compiled to native. Perry." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:image" content={imageUrl} />
    {image === DEFAULT_SOCIAL_IMAGE && <meta name="twitter:image:alt" content="Your TypeScript/JavaScript, compiled to native. Perry." />}
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Plausible (self-hosted), same snippet as the previous site. -->
    <script is:inline async src="https://pa.skelpo.com/js/pa-RM9JdedWZTuKvQnKJaGmY.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()
    </script>
  </head>
  <body>
    <Nav lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
