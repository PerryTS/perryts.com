---
import Menu from "@lucide/astro/icons/menu";
import Bird from "./Bird.astro";
import BrandIcon from "./BrandIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { pick, localePath, type Copy, type Locale } from "../i18n/index.ts";
import { formatCompact } from "../lib/format.ts";
import { getRepoStats } from "../lib/github.ts";
import { links } from "../lib/links.ts";

interface Props {
  lang: Locale;
  path?: string;
}
const { lang, path } = Astro.props;
const stats = await getRepoStats();

const copy: Copy<{ items: [string, string][]; menu: string; language: string; home: string }> = {
  en: {
    items: [["Docs", links.docs], ["Showcase", localePath("en", "showcase")], ["Benchmarks", "#benchmarks"], ["Publish", localePath("en", "publish")], ["For teams", "#teams"], ["Blog", localePath("en", "blog")]],
    menu: "Menu",
    language: "Change language",
    home: "Perry home",
  },
  es: {
    items: [["Docs", links.docs], ["Showcase", localePath("es", "showcase")], ["Benchmarks", "#benchmarks"], ["Publish", localePath("es", "publish")], ["Empresas", "#teams"], ["Blog", localePath("es", "blog")]],
    menu: "Menú",
    language: "Cambiar idioma",
    home: "Inicio de Perry",
  },
  de: {
    items: [["Dokumentation", links.docs], ["Showcase", localePath("de", "showcase")], ["Benchmarks", "#benchmarks"], ["Publish", localePath("de", "publish")], ["Für Teams", "#teams"], ["Blog", localePath("de", "blog")]],
    menu: "Menü",
    language: "Sprache ändern",
    home: "Perry Startseite",
  },
  fr: {
    items: [["Documentation", links.docs], ["Showcase", localePath("fr", "showcase")], ["Benchmarks", "#benchmarks"], ["Publish", localePath("fr", "publish")], ["Entreprises", "#teams"], ["Blog", localePath("fr", "blog")]],
    menu: "Menu",
    language: "Changer de langue",
    home: "Accueil Perry",
  },
  it: {
    items: [["Documentazione", links.docs], ["Showcase", localePath("it", "showcase")], ["Benchmark", "#benchmarks"], ["Publish", localePath("it", "publish")], ["Per i team", "#teams"], ["Blog", localePath("it", "blog")]],
    menu: "Menu",
    language: "Cambia lingua",
    home: "Home di Perry",
  },
  ja: {
    items: [["ドキュメント", links.docs], ["Showcase", localePath("ja", "showcase")], ["ベンチマーク", "#benchmarks"], ["Publish", localePath("ja", "publish")], ["チーム向け", "#teams"], ["ブログ", localePath("ja", "blog")]],
    menu: "メニュー",
    language: "言語を変更",
    home: "Perryホーム",
  },
  ko: {
    items: [["문서", links.docs], ["Showcase", localePath("ko", "showcase")], ["벤치마크", "#benchmarks"], ["Publish", localePath("ko", "publish")], ["팀용", "#teams"], ["블로그", localePath("ko", "blog")]],
    menu: "메뉴",
    language: "언어 변경",
    home: "Perry 홈",
  },
  pt: {
    items: [["Documentação", links.docs], ["Showcase", localePath("pt", "showcase")], ["Benchmarks", "#benchmarks"], ["Publish", localePath("pt", "publish")], ["Para equipes", "#teams"], ["Blog", localePath("pt", "blog")]],
    menu: "Menu",
    language: "Mudar idioma",
    home: "Página inicial do Perry",
  },
  th: {
    items: [["เอกสาร", links.docs], ["Showcase", localePath("th", "showcase")], ["เบนช์มาร์ก", "#benchmarks"], ["Publish", localePath("th", "publish")], ["สำหรับทีม", "#teams"], ["บล็อก", localePath("th", "blog")]],
    menu: "เมนู",
    language: "เปลี่ยนภาษา",
    home: "หน้าแรก Perry",
  },
  tr: {
    items: [["Dokümantasyon", links.docs], ["Showcase", localePath("tr", "showcase")], ["Benchmark'lar", "#benchmarks"], ["Publish", localePath("tr", "publish")], ["Ekipler için", "#teams"], ["Blog", localePath("tr", "blog")]],
    menu: "Menü",
    language: "Dili değiştir",
    home: "Perry ana sayfa",
  },
  vi: {
    items: [["Tài liệu", links.docs], ["Showcase", localePath("vi", "showcase")], ["Benchmark", "#benchmarks"], ["Publish", localePath("vi", "publish")], ["Cho đội nhóm", "#teams"], ["Blog", localePath("vi", "blog")]],
    menu: "Menu",
    language: "Đổi ngôn ngữ",
    home: "Trang chủ Perry",
  },
  id: {
    items: [["Dokumentasi", links.docs], ["Showcase", localePath("id", "showcase")], ["Benchmark", "#benchmarks"], ["Publish", localePath("id", "publish")], ["Untuk tim", "#teams"], ["Blog", localePath("id", "blog")]],
    menu: "Menu",
    language: "Ganti bahasa",
    home: "Beranda Perry",
  },
  "zh-Hans": {
    items: [["文档", links.docs], ["Showcase", localePath("zh-Hans", "showcase")], ["基准测试", "#benchmarks"], ["Publish", localePath("zh-Hans", "publish")], ["团队版", "#teams"], ["博客", localePath("zh-Hans", "blog")]],
    menu: "菜单",
    language: "切换语言",
    home: "Perry 首页",
  },
};
const t = pick(copy, lang);
---

<header class="nav">
  <div class="wrap row">
    <a class="brand" href={localePath(lang)} aria-label={t.home}>
      <Bird size={28} />
      <span>perry</span>
    </a>
    <nav class="links" aria-label="Main">
      {t.items.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="right">
      <LanguageSwitcher lang={lang} path={path} label={t.language} />
      <a class="discord" href={links.discord}><BrandIcon name="discord" /><span>Discord</span></a>
      <a class="github" href={links.github}>
        <BrandIcon name="github" />
        <span>GitHub</span>
        <span class="stars">{formatCompact(stats.stars, lang)}</span>
      </a>
      <details class="mobile">
        <summary aria-label={t.menu}><Menu size={20} stroke-width={1.75} aria-hidden="true" /></summary>
        <nav aria-label={t.menu}>
          {t.items.map(([label, href]) => <a href={href}>{label}</a>)}
          <a href={links.discord}>Discord</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
  }
  .links {
    display: flex;
    gap: 32px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .links a:hover,
  .discord:hover {
    color: var(--text);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .discord {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .github {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
  }
  .github:hover {
    border-color: var(--text-muted);
  }
  .stars {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .mobile {
    display: none;
    position: relative;
  }
  .mobile summary {
    list-style: none;
    cursor: pointer;
    padding: 6px;
  }
  .mobile summary::-webkit-details-marker {
    display: none;
  }
  .mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: flex;
    flex-direction: column;
    min-width: 200px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    z-index: 20;
  }
  .mobile nav a {
    padding: 10px 12px;
    font-size: 15px;
  }
  @media (max-width: 1100px) {
    .links,
    .discord {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .github span:not(.stars) {
      display: none;
    }
  }
</style>
