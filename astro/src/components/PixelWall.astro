---
/** Pixel columns in solid steps of the bird palette. No gradients: each colour owns a run of columns. */
interface Props {
  heights?: number[];
  pixel?: number;
}
const DEFAULT = [1,1,2,1,2,3,2,2,3,4,3,2,3,4,4,3,4,5,4,3,4,5,5,4,5,6,5,4,5,6,6,5,4,5,6,5,4,4,5,4,3,4,3,3,2,3,2,1];
const { heights = DEFAULT, pixel = 20 } = Astro.props;
const palette = ["--pixel-amber", "--pixel-orange", "--pixel-red", "--pixel-pink", "--pixel-lilac", "--pixel-blue"];
const run = heights.length / palette.length;
---

<div class="wall" aria-hidden="true" style={`--px: ${pixel}px`}>
  {heights.map((h, i) => (
    <div class="col" data-grow="y" style={`--i: ${i}; --c: var(${palette[Math.min(palette.length - 1, Math.floor(i / run))]})`}>
      {Array.from({ length: h }, (_, j) => <span class:list={["px", { top: j === 0 }]} />)}
    </div>
  ))}
</div>

<style>
  .wall {
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }
  .col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .px {
    height: var(--px);
    background: color-mix(in srgb, var(--c) 55%, transparent);
  }
  .px.top {
    background: var(--c);
  }
  @media (max-width: 640px) {
    .wall {
      --px: 10px !important;
      gap: 2px;
    }
    .col {
      gap: 2px;
    }
  }
</style>
