---

<footer class="footer">
  <div class="wrap inner">
    <div class="row">
      <div class="brand">
        <a class="lockup" href={p("")}><Bird size={26} /><span>perry</span></a>
        <p class="muted">{t.tagline}</p>
      </div>
      <div class="columns">
        {t.columns.map((c) => (
          <nav aria-label={c.title}>
            <p class="t-label accent">{c.title}</p>
            <ul>{c.items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="served">
      <div class="served__left">
        <span class="live" aria-hidden="true"></span>
        <span>{t.served}</span>
        <code class="t-mono accent">$ perry compile native-entry/server.ts</code>
      </div>
      <a class="served__link muted" href={links.serverSource}>{t.source}<ArrowUpRight size={14} stroke-width={1.75} aria-hidden="true" /></a>
    </div>
    <div class="bottom t-mono muted">
      <span>{t.rights}</span>
      <span class="legal">
        <a href={p("imprint")}>{t.legal}</a>
        <a href={p("privacy")}>{t.privacy}</a>
        <span>{localeLabels[lang].name}</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 72px 40px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 360px;
    font-size: 15px;
    line-height: 1.5;
  }
  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
  }
  .columns {
    display: flex;
    gap: 80px;
  }
  .columns nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .columns ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .columns a:hover,
  .legal a:hover,
  .served__link:hover {
    color: var(--text);
  }
  .served {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 18px 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 14px;
  }
  .served__left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .served__link {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
  }
  .legal {
    display: flex;
    gap: 20px;
  }
  @media (max-width: 900px) {
    .row,
    .served,
    .bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .columns {
      gap: 40px;
      flex-wrap: wrap;
    }
  }
</style>
