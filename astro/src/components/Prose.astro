---
/**
 * Long-form text styling (blog posts, legal pages, docs-like pages).
 * Wrap rendered Markdown or plain HTML in it; children are styled by element, no classes needed.
 */
interface Props {
  class?: string;
}
---

<div class:list={["prose", Astro.props.class]}><slot /></div>

<style>
  .prose {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text);
    overflow-wrap: break-word;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.033em;
    line-height: 1.15;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .prose :global(h4) {
    margin-top: 1.6em;
    font-size: 19px;
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--text-muted);
  }
  .prose :global(blockquote) {
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-size: 21px;
    line-height: 1.5;
    font-weight: 500;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin-block: 2.4em;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .prose :global(pre) {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface) !important;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .prose :global(pre code) {
    font-family: inherit;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .prose :global(img),
  .prose :global(video) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .prose :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
