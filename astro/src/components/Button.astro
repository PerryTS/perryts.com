---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "button" | "submit";
  class?: string;
}
const { href, variant = "primary", type = "button", class: className } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class:list={["btn", `btn--${variant}`, className]} href={href} type={href ? undefined : type}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 20px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 150ms linear, border-color 150ms linear;
  }
  .btn--primary {
    background: var(--accent);
    color: var(--bg);
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, white);
  }
  .btn--secondary {
    border: 1px solid var(--border);
    font-weight: 500;
  }
  .btn--secondary:hover {
    border-color: var(--text-muted);
  }
</style>
