---
import type { Copy, Locale } from "../i18n/index.ts";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface Spec {
  value: string;
  label: string;
  note: string;
}
const copy: Copy<{ label: string; specs: Spec[] }> = {
  en: {
    label: "Perry at a glance",
    specs: [
      { value: "11", label: "documented targets", note: "+ HarmonyOS preview" },
      { value: "~330 KB", label: "hello-world binary", note: "size grows with features" },
      { value: "3.5 MB", label: "peak memory, JSON pipeline", note: "Node.js uses 36 MB" },
      { value: "35+", label: "native widgets", note: "no WebView, no CSS" },
    ],
  },
  es: {
    label: "Perry de un vistazo",
    specs: [
      { value: "11", label: "plataformas documentadas", note: "+ HarmonyOS en preview" },
      { value: "~330 KB", label: "binario hello-world", note: "crece con las funcionalidades" },
      { value: "3,5 MB", label: "memoria máxima, pipeline JSON", note: "Node.js usa 36 MB" },
      { value: "35+", label: "widgets nativos", note: "sin WebView, sin CSS" },
    ],
  },
};
const t = copy[lang];
---

<section class="spec-strip" aria-label={t.label}>
  <ul class="wrap specs">
    {t.specs.map((s, i) => (
      <li class="spec" data-reveal style={`--i: ${i}`}>
        <span class="idx">{String(i + 1).padStart(2, "0")}</span>
        <span class="value" data-count>{s.value}</span>
        <span class="label">{s.label}</span>
        <span class="note">{s.note}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .spec-strip {
    border-block: 1px solid var(--border);
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .spec {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px;
  }
  .spec:first-child {
    padding-inline: 0 28px;
  }
  .spec + .spec {
    border-left: 1px solid var(--border);
  }
  .idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  .value {
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .label {
    font-size: 15px;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  @media (max-width: 900px) {
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
    .spec:nth-child(odd) {
      padding-inline: 0 24px;
      border-left: 0;
    }
    .spec:nth-child(even) {
      padding-inline: 24px 0;
    }
    .spec:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 480px) {
    .specs {
      grid-template-columns: 1fr;
    }
    .spec,
    .spec:nth-child(even) {
      padding: 24px 0;
      border-left: 0;
    }
    .spec + .spec {
      border-top: 1px solid var(--border);
    }
    .value {
      font-size: 34px;
    }
  }
</style>
