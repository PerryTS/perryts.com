[Unit]
Description=perryts.com newsletter subscribe helper
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/perryts.com/current
EnvironmentFile=/etc/perryts.env
ExecStart=/usr/bin/node /var/www/perryts.com/current/subscribe-server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
